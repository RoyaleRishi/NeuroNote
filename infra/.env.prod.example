# infra/.env.prod.example
# Copy to infra/.env.prod and fill in all values before deploying.
# Never commit .env.prod — it is gitignored.

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=neuronote.rsrikaanth.com

# ── Database ──────────────────────────────────────────────────────────────────
# Strong random password: openssl rand -hex 32
DB_PASSWORD=

# ── JWT / session ─────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32
SESSION_SECRET=

# ── Preferences encryption (Fernet key for llm_api_key at rest) ───────────────
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable encryption (plaintext stored).
PREF_ENCRYPTION_KEY=

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com/v1/

# ── OAuth — Google ────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://neuronote.rsrikaanth.com/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub ────────────────────────────────────────────────────────────
# github.com/settings/developers → OAuth Apps
# Authorization callback URL: https://neuronote.rsrikaanth.com/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── API key (optional static API key for server-to-server calls) ──────────────
API_KEY=
